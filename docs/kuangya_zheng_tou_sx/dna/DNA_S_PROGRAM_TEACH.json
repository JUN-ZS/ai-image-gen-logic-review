  "lessons": [
    {
      "S": "S0",
      "name": "L0 凍",
      "layer": "A",
      "teach": "同機位原圖寫死；下游禁止重算場景",
      "do": [
        "freeze SRC",
        "RESET_DONOR 僅鏈頭"
      ],
      "bus_write": [
        "SRC"
      ],
      "anti": "反除的對照基",
      "fail_if": "中途換底圖 / 無 freeze"
