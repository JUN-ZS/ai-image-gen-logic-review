      ],
      "bus_write": [
        "boost_all_three"
      ],
      "anti": "弱針 = 無針",
      "fail_if": "E-KY-BOOST-04",
      "sx_relock": true
    },
    {
      "S": "S9",
      "name": "正生",
      "layer": "B",
      "teach": "外力在正洞座位上 seat-born 生（回洞關鍵·身份填入座位）",
