      "name": "正除",
      "layer": "A",
      "teach": "外力GROK EDIT 去頭/件 → L1；不是 OpenCV 擦",
      "do": [
        "imagine_image_to_image 除"
      ],
      "bus_write": [
        "L1"
      ],
      "anti": "反除 = L0 有 vs L1 無",
      "fail_if": "E-FA-12 本地假除"
    },
    {
      "S": "S2",
      "name": "正扣",
      "layer": "A",
      "teach": "扣只作證：差分或除背→CLIP；不重寫洞",
      "do": [
        "|L0-L1|",
        "可選 除背→M_subj"
      ],
      "bus_write": [
        "kou_map",
        "CLIP?"
      ],
      "anti": "反扣 = 緣反查 · 禁 self_peep",
      "fail_if": "E-FA-09 扣改洞主權 · E-CLIP-01 自 peep 冒 CLIP"
    },
    {
      "S": "S3",
      "name": "正洞 MARK",
      "layer": "A",
      "teach": "洞=抓走前座位；先 MARK 再咬；真洞=像素真去",
      "do": [
        "MARK 凍 M · corners_4",
        "真洞板 checker/void"
      ],
      "bus_write": [
        "MARK",
        "corners_4"
      ],
      "anti": "反洞 = 洞外 bitexact 義務",
      "fail_if": "E-FA-08 先除後猜 · E-FA-10 紫疊冒洞"
    },
    {
      "S": "S4",
      "name": "部件'認'",
      "layer": "B",
      "teach": "外力認出：咬出塊=整體中的獨立部件（整件身份）",
