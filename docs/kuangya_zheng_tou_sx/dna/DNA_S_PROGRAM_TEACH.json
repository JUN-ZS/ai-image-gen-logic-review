      ],
      "bus_write": [
        "elev_candidate"
      ],
      "anti": "elev 只候選",
      "fail_if": "E-ED-01..03 · E-KY-ATX",
      "boost": "ELEV_x",
      "sx_relock": true
    },
    {
      "S": "S8",
      "name": "BOOST AND",
      "layer": "B",
      "teach": "認∩放大∩升質 缺一禁 BOOST 正標",
      "do": [
