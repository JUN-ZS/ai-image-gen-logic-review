  "spaces": {
    "D": "dst full (W_d,H_d)",
    "S": "src full native (W_s,H_s)",
    "S_eff": "src after int resize (nw,nh) with s_eff",
    "C": "cell crop in D",
    "C_up": "cell * U"
  },
  "formulas": {
    "s_face": "sqrt( (w_d/w_s) * (h_d/h_s) )",
    "s_eff_after_resize": "0.5 * (nw/W_s + nh/H_s)  # or (nw/W_s) if only X tracked",
    "place_tl": "c_d - c_s * s_eff",
    "S_to_D": "p_D = p_S * s_eff + place_tl",
    "D_to_S": "p_S = (p_D - place_tl) / s_eff",
    "FACE_CROP_DIRECT": {
      "crop_S": "expand(F_s, pad≤0.12)",
      "scale": "s_face",
      "place": "c_d - c_s_in_crop * s_face",
      "mask": "ellipse on F_d + hammer_kill"
    },
    "FAT": {
      "face_C": "(x-x0, y-y0, w, h)",
      "face_Cup": "face_C * U",
      "reinsert_center_D": "face_Cup_center / U + (x0,y0)"
    },
    "GRID_box": "clamp(core ± ω*core_size, image)",
    "GRID_local_to_D": "local + box_origin"
  },
